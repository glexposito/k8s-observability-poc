{
  "uid": "queue-consumer-overview",
  "title": "queue-consumer overview",
  "tags": [
    "k8s-observability-poc",
    "opentelemetry"
  ],
  "description": "Same panels as the SigNoz dashboard of the same name. Source: k8s-observability-poc/observability/dashboards.",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k8s_deployment_desired{k8s_deployment_name=\"queue-consumer\"}, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(k8s_deployment_desired{k8s_deployment_name=\"queue-consumer\"}, deployment_environment_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Queue consumer: rate, errors, duration",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages processed / s",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "messages.processed counter from the OTel SDK. Each replica processes one message every 5 s, so prod (3 replicas) should run at ~3x internal.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (deployment_environment_name) (rate(messages_processed_total{deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "do_work error ratio",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of do_work spans with error status, from the agent's span_metrics connector (traces.span.metrics.calls).",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(sum by (deployment_environment_name) (rate(traces_span_metrics_calls_total{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or sum by (deployment_environment_name) (rate(traces_span_metrics_calls_total{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\"}[$__rate_interval])) * 0) / sum by (deployment_environment_name) (rate(traces_span_metrics_calls_total{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "do_work duration (p50 / p95 / p99)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "From traces.span.metrics.duration (agent span_metrics connector). Buckets start at 0.1 ms.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, deployment_environment_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50 {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, deployment_environment_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95 {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, deployment_environment_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"queue-consumer\", span_name=\"do_work\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p99 {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Workload health",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Replicas: available vs desired",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "From otel-k8s-state (k8s_cluster receiver). Dashed = desired.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "desired.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (deployment_environment_name) (k8s_deployment_available{k8s_deployment_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "available {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (deployment_environment_name) (k8s_deployment_desired{k8s_deployment_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "desired {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU per pod",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Kubelet stats from the otel-agent. Dashed = container limit.",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "limit.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (deployment_environment_name, k8s_pod_name) (k8s_pod_cpu_usage{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "{{deployment_environment_name}} {{k8s_pod_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "max by (deployment_environment_name) (k8s_container_cpu_limit{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "limit {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory per pod (working set)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Kubelet stats from the otel-agent. Dashed = container limit (OOMKill above it).",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "limit.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (deployment_environment_name, k8s_pod_name) (k8s_pod_memory_working_set_bytes{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "{{deployment_environment_name}} {{k8s_pod_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "max by (deployment_environment_name) (k8s_container_memory_limit_bytes{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "limit {{deployment_environment_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Container restarts",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total container restarts per environment (otel-k8s-state). Anything above 0 means crashes or OOM kills.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "sum by (deployment_environment_name) (k8s_container_restarts{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"})",
          "legendFormat": "{{deployment_environment_name}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pods not Running",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pods in Pending/Failed/Unknown phase (k8s.pod.phase != 2). ImagePullBackOff pods show up here as Pending.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "count by (deployment_environment_name) (k8s_pod_phase{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\"} != 2)",
          "legendFormat": "{{deployment_environment_name}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "What's happening",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "queue-consumer logs",
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Container stdout, shipped from /var/log/pods by the otel-agent.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "expr": "{k8s_namespace_name=\"queue-consumer\", deployment_environment_name=~\"$env\", service_name!=\"unknown_service\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Kubernetes warning events",
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Warning events from Kubernetes (k8s_events receiver in otel-k8s-state): failed pulls, OOM kills, scheduling failures.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "expr": "{deployment_environment_name=~\"$env\"} | k8s_namespace_name=\"queue-consumer\" | severity_text=\"Warning\" | line_format \"[{{.deployment_environment_name}}] {{.k8s_event_reason}} {{.k8s_object_kind}}/{{.k8s_object_name}}: {{__line__}}\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent do_work traces",
      "id": 14,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "TraceQL search in Tempo. Click a trace ID to open it.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.service.name=\"queue-consumer\" && resource.deployment.environment.name=~\"${env:regex}\" && name=\"do_work\"}"
        }
      ]
    }
  ]
}
